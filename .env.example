# MAXIMUS AI Assistant Configuration

# Server Configuration
PORT=3000
NODE_ENV=development

# AI Model Configuration
# Options: "ollama" or "deepseek"
AI_PROVIDER=ollama

# Ollama Configuration (for local models)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama2

# DeepSeek Configuration (for cloud models)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat

# Telegram Bridge Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_ENABLED=false

# WhatsApp Bridge Configuration
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER=your_phone_number

# Dashboard Configuration
DASHBOARD_TITLE=MAXIMUS AI Assistant
DASHBOARD_THEME=gold-purple

# Personality Configuration
PERSONALITY_FILE=./PERSONALITY.md
